# QMT Live Assistant 环境变量示例
# 复制本文件为 .env 并根据需要修改

# 服务器监听地址与端口
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# FastAPI 子路径，用于 nginx 子路径代理（如 /qmt）
ROOT_PATH=/qmt_live_assistant

# 外部访问 URL 前缀（桌面托盘/窗口打开浏览器时使用）
# BASE_URL=https://example.com/qmt

# 跨域配置
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

# miniQMT 路径与账户 ID（CLI 模式或桌面模式可直接启动）
# MINI_QMT_PATH=C:\\国金QMT交易端\\userdata_mini
# ACCOUNT_ID=1234567890

# 日志级别
LOG_LEVEL=INFO

# 企业微信通知 Webhook
# WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# 源平台状态通知 webhook 映射（JSON 字符串）
# SOURCE_PLATFORM_WEBHOOKS={"joinquant":"https://your-server.com/callback"}

# 数据持久化
PERSISTENCE_MODE=sqlite
DATABASE_URL=sqlite:///./data/qmt_live_assistant.db
